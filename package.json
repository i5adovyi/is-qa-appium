{
  "name": "is-qa-appium",
  "version": "1.0.0",
  "private": true,
  "description": "Training project: mobile test automation with Appium + WebdriverIO + TypeScript + Mocha/Chai + BrowserStack",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "test": "npm run test:smoke",
    "preflight": "node scripts/preflight.mjs",
    "course": "node scripts/course-server.mjs",
    "course:build": "node scripts/build-course.mjs",
    "course:preview": "node scripts/course-preview.mjs",
    "course:sites": "npm run course:build && node scripts/prepare-site.mjs",
    "course:check": "node scripts/check-course.mjs",
    "course:test": "node --test scripts/course-server.test.mjs scripts/course-reader.test.mjs scripts/course-assignments.test.mjs scripts/course-progress.test.mjs scripts/course-practice.test.mjs scripts/course-static.test.mjs scripts/course-storage.test.mjs scripts/progress-store.test.mjs scripts/progress-api.test.mjs scripts/site-profile.test.mjs",
    "practice": "node scripts/practice.mjs",
    "practice:solutions": "node scripts/practice.mjs --solutions",
    "typecheck:practice": "tsc -p tsconfig.practice.json",
    "framework:test": "node --test test/unit/*.test.mjs",
    "check": "npm run typecheck && npm run typecheck:practice && npm run course:check && npm run practice:solutions && npm run framework:test",
    "app:download": "node scripts/download-app.mjs",
    "app:verify": "node scripts/download-app.mjs --verify",
    "audit": "npm audit --audit-level=low",
    "appium:setup": "node scripts/check-driver.mjs",
    "appium:doctor": "appium driver doctor uiautomator2",
    "typecheck": "tsc --noEmit",
    "test:android": "wdio run config/wdio.android.conf.ts",
    "test:bs": "node scripts/run-browserstack.mjs",
    "test:smoke": "wdio run config/wdio.android.conf.ts --mochaOpts.grep @smoke",
    "test:forms": "wdio run config/wdio.android.conf.ts --spec test/specs/app.forms.spec.ts",
    "test:login": "wdio run config/wdio.android.conf.ts --spec test/specs/app.login.spec.ts",
    "course:site-profile": "node scripts/site-profile.mjs",
    "progress:status": "node scripts/progress-db.mjs status",
    "progress:backup": "node scripts/progress-db.mjs backup",
    "progress:import": "node scripts/progress-db.mjs import",
    "training:apps": "node scripts/training-apps.mjs",
    "test:training": "node scripts/run-training.mjs"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@wdio/appium-service": "^10.1.0",
    "@wdio/cli": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "file:vendor/appium-uiautomator2-driver-8.7.0-unbundled.tgz",
    "chai": "^5.3.3",
    "marked": "18.1.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@appium/base-driver": "10.8.1",
    "@appium/support": "7.2.8",
    "shell-quote": "1.12.0",
    "sharp": "0.35.5"
  }
}
