# Copy to .env and fill in from https://www.browserstack.com/accounts/profile/details
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# Optional: choose a device/OS pair currently available in your account.
BROWSERSTACK_DEVICE_NAME=Samsung Galaxy S24
BROWSERSTACK_PLATFORM_VERSION=14.0
# BROWSERSTACK_BUILD_NAME=training-my-first-cloud-run

# Optional: use `adb devices` to select one device if several are connected.
# ANDROID_UDID=emulator-5554
